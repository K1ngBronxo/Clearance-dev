{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "clearance",
          "version": "0.9.1",
          "informationUri": "https://clearance.dev",
          "rules": [
            {
              "id": "copyleft.network",
              "name": "AGPL network clause contradicts a closed-source deployment",
              "shortDescription": {
                "text": "AGPL network clause contradicts a closed-source deployment"
              },
              "helpUri": "https://www.gnu.org/licenses/agpl-3.0.html",
              "properties": {
                "clearance.confidence": "HIGH",
                "clearance.licence": "AGPL-3.0-only",
                "clearance.severity": "BLOCK",
                "clearance.trap": "trap.agpl.network-service"
              }
            },
            {
              "id": "licence.custom",
              "name": "Model weights carry a bespoke community licence",
              "shortDescription": {
                "text": "Model weights carry a bespoke community licence"
              },
              "helpUri": "https://llama.meta.com/llama3_1/license/",
              "properties": {
                "clearance.confidence": "HIGH",
                "clearance.licence": "Llama-3.1-Community",
                "clearance.severity": "BLOCK",
                "clearance.trap": "trap.weights.mau-threshold"
              }
            },
            {
              "id": "notice.required",
              "name": "Notice file presence could not be confirmed",
              "shortDescription": {
                "text": "Notice file presence could not be confirmed"
              },
              "helpUri": "https://opensource.org/license/mit",
              "properties": {
                "clearance.confidence": "LOW",
                "clearance.licence": "MIT",
                "clearance.severity": "NOTE"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "copyleft.network",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "some-agpl-lib (AGPL-3.0-only): The dependency is licensed under the AGPL, which requires that users interacting with a modified version over a network be offered the Corresponding Source. The declared intent is a closed-source service, so the obligation cannot be met without a licence change or removing the dependency. (confidence: HIGH) Suggested fix: Replace with a permissively licensed alternative. (alternative: crawl4ai)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "package-lock.json"
                },
                "region": {
                  "startLine": 1042,
                  "endLine": 1048
                }
              }
            }
          ]
        },
        {
          "ruleId": "licence.custom",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "models/llama-3.1-8b.bin (Llama-3.1-Community): The weights are governed by a bespoke community licence that is not an OSI-approved licence and carries field-of-use restrictions the declared intent does not satisfy. (confidence: HIGH)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "models/README.md"
                },
                "region": {
                  "startLine": 1,
                  "endLine": 3
                }
              }
            }
          ]
        },
        {
          "ruleId": "notice.required",
          "ruleIndex": 2,
          "level": "note",
          "message": {
            "text": "tiny-mit (MIT): The package declares MIT but no NOTICE file was found in the vendored directory. (confidence: LOW)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "node_modules/tiny-mit/package.json"
                },
                "region": {
                  "startLine": 1
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
