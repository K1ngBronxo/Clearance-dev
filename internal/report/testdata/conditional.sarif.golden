{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "clearance",
          "version": "0.9.1",
          "informationUri": "https://clearance.dev",
          "rules": [
            {
              "id": "attribution.required",
              "name": "Attribution notice must be preserved",
              "shortDescription": {
                "text": "Attribution notice must be preserved"
              },
              "helpUri": "https://opensource.org/license/mit",
              "properties": {
                "clearance.confidence": "HIGH",
                "clearance.licence": "MIT",
                "clearance.severity": "CONDITION"
              }
            },
            {
              "id": "licence.ambiguous",
              "name": "Licence text could not be classified",
              "shortDescription": {
                "text": "Licence text could not be classified"
              },
              "helpUri": "https://example.invalid/leftpad/LICENSE",
              "properties": {
                "clearance.confidence": "LOW",
                "clearance.severity": "NOTE"
              }
            },
            {
              "id": "network.disclosure",
              "name": "Network disclosure clause may apply",
              "shortDescription": {
                "text": "Network disclosure clause may apply"
              },
              "helpUri": "https://www.gnu.org/licenses/agpl-3.0.html",
              "properties": {
                "clearance.confidence": "MEDIUM",
                "clearance.licence": "BSD-3-Clause",
                "clearance.severity": "CONDITION"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "network.disclosure",
          "ruleIndex": 2,
          "level": "warning",
          "message": {
            "text": "torch (BSD-3-Clause): A network-interaction clause appears to apply, but the clause text is ambiguous about whether an internal-only deployment counts as interaction. (confidence: MEDIUM)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "requirements.txt"
                },
                "region": {
                  "startLine": 4
                }
              }
            }
          ]
        },
        {
          "ruleId": "attribution.required",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "@mendable/firecrawl-js (MIT): The dependency is distributed under a licence whose attribution clause requires the notice to travel with every redistribution of the software, including a bundled web build. (confidence: HIGH) Suggested fix: Include the dependency's NOTICE file in the distributed bundle."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "package.json"
                },
                "region": {
                  "startLine": 12
                }
              }
            }
          ]
        },
        {
          "ruleId": "licence.ambiguous",
          "ruleIndex": 1,
          "level": "note",
          "message": {
            "text": "leftpad: The licence file is a short custom notice that names no SPDX identifier and the tool could not map it to a known licence. (confidence: LOW)"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "Cargo.lock"
                },
                "region": {
                  "startLine": 88,
                  "endLine": 90
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
